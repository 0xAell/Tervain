{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ael-dev3.github.io/Tervain/data/schema/game/interactables.schema.json",
  "title": "game/interactables.json",
  "description": "Everything the wanderer can act on: where it is, how near he must come, its place in the order of offers (lower first; each whole step outweighs two metres), the solids that are the thing itself, the facts of the moment it needs, and what acting on it does. When the state offers each, and its prompt, are rules in core/rules/interactables.ts.",
  "type": "object",
  "properties": {
    "about": {
      "type": "string"
    },
    "units": {
      "type": "string"
    },
    "reachHeights": {
      "type": "object",
      "properties": {
        "resident": {
          "type": "number"
        },
        "rider": {
          "type": "number"
        },
        "groundPoint": {
          "type": "integer"
        },
        "eye": {
          "type": "number"
        }
      },
      "required": [
        "resident",
        "rider",
        "groundPoint",
        "eye"
      ],
      "additionalProperties": false
    },
    "interactables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "place": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "above": {
                "type": "number"
              },
              "mount": {
                "type": "string"
              },
              "npc": {
                "type": "string"
              },
              "pickup": {
                "type": "string"
              }
            },
            "required": [
              "at"
            ],
            "additionalProperties": false
          },
          "reach": {
            "type": "number"
          },
          "priority": {
            "type": "number"
          },
          "ignoreColliders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "act": {
            "type": "object",
            "properties": {
              "do": {
                "type": "string"
              },
              "mount": {
                "type": "string"
              },
              "npc": {
                "type": "string"
              },
              "point": {
                "type": "string"
              },
              "pickup": {
                "type": "string"
              },
              "item": {
                "type": "string"
              },
              "qty": {
                "type": "integer"
              }
            },
            "required": [
              "do"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "place",
          "reach",
          "priority",
          "ignoreColliders",
          "needs",
          "act"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "units",
    "reachHeights",
    "interactables"
  ],
  "additionalProperties": false
}
