{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ael-dev3.github.io/Tervain/data/schema/game/inspections.schema.json",
  "title": "game/inspections.json",
  "description": "What can be examined in the world: requirements, effects and the notice shown. Positions are in world/layout.json.",
  "type": "object",
  "properties": {
    "about": {
      "type": "string"
    },
    "units": {
      "type": "string"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "trigger": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "via": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "t"
              ],
              "additionalProperties": false
            }
          },
          "noticeKey": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "effects",
          "noticeKey"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "units",
    "points"
  ],
  "additionalProperties": false
}
