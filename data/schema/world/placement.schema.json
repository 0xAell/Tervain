{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ael-dev3.github.io/Tervain/data/schema/world/placement.schema.json",
  "title": "world/placement.json",
  "description": "What lies and grows on the ground besides the trees, as the placement rules author it once from fixed seeds: the woodland floor (ferns, shrubs, moss, litter, fallen logs and their fungi), the loose stone (beach pebbles, surf rocks, sea stacks, inland erratics, the lighthouse’s boulders, shelf stone) and the shore’s driftwood and scrub. `rank` is 0 to 1: a detail level keeps what ranks below its share in `detailKeep`; stones with an obstacle radius, sea stacks and stones large enough to be solid are kept at every level. A stone’s resting height is left to its own shape: `groundY` is the ground under its centre.",
  "type": "object",
  "properties": {
    "about": {
      "type": "string"
    },
    "units": {
      "type": "string"
    },
    "detailKeep": {
      "type": "object",
      "properties": {
        "stones": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number"
            },
            "medium": {
              "type": "number"
            },
            "high": {
              "type": "integer"
            }
          },
          "required": [
            "low",
            "medium",
            "high"
          ],
          "additionalProperties": false
        },
        "woodlandFloor": {
          "type": "object",
          "properties": {
            "low": {
              "type": "number"
            },
            "medium": {
              "type": "number"
            },
            "high": {
              "type": "integer"
            }
          },
          "required": [
            "low",
            "medium",
            "high"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "stones",
        "woodlandFloor"
      ],
      "additionalProperties": false
    },
    "woodlandFloorFade": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer"
          },
          "end": {
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "stoneShapes": {
      "type": "integer"
    },
    "woodlandFloor": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "yaw": {
            "type": "number"
          },
          "scale": {
            "type": "number"
          },
          "rank": {
            "type": "number"
          },
          "variant": {
            "type": "integer"
          },
          "colony": {
            "type": "string"
          },
          "onLog": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "x",
          "y",
          "z",
          "yaw",
          "scale",
          "rank",
          "variant",
          "colony",
          "onLog"
        ],
        "additionalProperties": false
      }
    },
    "stones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "groundY": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "size": {
            "type": "number"
          },
          "shape": {
            "type": "integer"
          },
          "yaw": {
            "type": "number"
          },
          "squash": {
            "type": "number"
          },
          "rank": {
            "type": "number"
          },
          "obstacleRadius": {
            "type": "number"
          },
          "solid": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "x",
          "groundY",
          "z",
          "size",
          "shape",
          "yaw",
          "squash",
          "rank",
          "obstacleRadius",
          "solid"
        ],
        "additionalProperties": false
      }
    },
    "shore": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "yaw": {
            "type": "number"
          },
          "scale": {
            "type": "number"
          },
          "rank": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "x",
          "y",
          "z",
          "yaw",
          "scale",
          "rank"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "about",
    "units",
    "detailKeep",
    "woodlandFloorFade",
    "stoneShapes",
    "woodlandFloor",
    "stones",
    "shore"
  ],
  "additionalProperties": false
}
