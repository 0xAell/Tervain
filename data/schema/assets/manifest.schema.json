{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ael-dev3.github.io/Tervain/data/schema/assets/manifest.schema.json",
  "title": "assets/manifest.json",
  "description": "Every model, texture, image and sound in the repository's asset folders, with what an Unreal Engine port does with it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["about", "generatedBy", "plans", "unrealConventions", "totals", "fab", "groups", "assets"],
  "properties": {
    "about": { "type": "string" },
    "generatedBy": { "type": "string" },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replace", "keep", "rework", "drop"],
      "properties": { "replace": { "type": "string" }, "keep": { "type": "string" }, "rework": { "type": "string" }, "drop": { "type": "string" } }
    },
    "unrealConventions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "up", "handedness", "forward", "import", "contentRoot", "prefixes", "prefixSource", "textureSuffixes", "naming", "lod"],
      "properties": {
        "units": { "const": "centimetres" },
        "up": { "const": "Z" },
        "handedness": { "const": "left-handed" },
        "forward": { "const": "+X" },
        "import": { "type": "string" },
        "contentRoot": { "type": "string", "pattern": "^/Game/" },
        "prefixes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/prefix" },
          "required": ["StaticMesh", "SkeletalMesh", "Texture", "Material", "MaterialInstance"],
          "properties": { "StaticMesh": { "$ref": "#/$defs/prefix" }, "SkeletalMesh": { "$ref": "#/$defs/prefix" }, "Texture": { "$ref": "#/$defs/prefix" }, "Material": { "$ref": "#/$defs/prefix" }, "MaterialInstance": { "$ref": "#/$defs/prefix" } }
        },
        "prefixSource": { "type": "string" },
        "textureSuffixes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^_[A-Z]+$" } },
        "naming": { "type": "string" },
        "lod": { "type": "string" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "shipped", "byPlan"],
      "properties": {
        "all": { "$ref": "#/$defs/count" },
        "shipped": { "$ref": "#/$defs/count" },
        "byPlan": { "type": "object", "additionalProperties": false, "required": ["replace", "keep", "rework", "drop"], "properties": { "replace": { "$ref": "#/$defs/count" }, "keep": { "$ref": "#/$defs/count" }, "rework": { "$ref": "#/$defs/count" }, "drop": { "$ref": "#/$defs/count" } } }
      }
    },
    "fab": {
      "description": "What to look for on Fab for each replacement, keyed by the category a group names.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["brief", "constraints", "candidates"],
        "properties": {
          "brief": { "type": "string" },
          "constraints": { "type": "string" },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "publisher", "verified"],
              "properties": {
                "title": { "type": "string" },
                "publisher": { "type": "string" },
                "url": { "type": ["string", "null"] },
                "note": { "type": "string" },
                "verified": { "description": "How the listing was confirmed to exist when the manifest was written.", "enum": ["listing page", "search result", "not verified"] }
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "role", "plan", "why", "source", "fab", "files", "bytes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "role": { "enum": ["hero", "resident", "animation", "animal", "tree", "scenery", "furniture", "debug", "building-material", "foliage-texture", "identity", "music", "voice", "sound", "archive"] },
          "plan": { "$ref": "#/$defs/plan" },
          "why": { "type": "string", "minLength": 20 },
          "source": { "type": "string", "minLength": 10 },
          "fab": { "type": ["string", "null"] },
          "files": { "type": "integer", "minimum": 1 },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "group", "kind", "bytes", "sha256", "shipped", "licence", "plan", "unreal"],
        "properties": {
          "path": { "type": "string", "pattern": "^(public|assets)/" },
          "group": { "type": "string" },
          "kind": { "enum": ["model", "texture", "image", "audio", "data"] },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "shipped": { "description": "Whether the web build serves the file (it is under public/).", "type": "boolean" },
          "sourceId": { "description": "The source record in the model ledger (public/model-licenses.json).", "type": "string" },
          "licence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "description": "An SPDX identifier, or a LicenseRef- name for terms that have none.", "type": "string", "pattern": "^(CC0-1\\.0|LicenseRef-[A-Za-z0-9.-]+)$" },
              "status": { "description": "How well the licence is established, in the words of its record.", "type": "string", "minLength": 3 }
            }
          },
          "plan": { "$ref": "#/$defs/plan" },
          "unreal": {
            "description": "The Unreal asset an import of this file produces; null when nothing is imported from it.",
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["type", "folder", "name", "lod"],
            "properties": {
              "type": { "enum": ["StaticMesh", "SkeletalMesh", "Texture", "AnimationSequence", "SoundWave"] },
              "folder": { "type": "string", "pattern": "^/Game/Tervain/" },
              "name": { "type": "string", "pattern": "^(SM|SK|T|AS|SW)_[A-Za-z0-9_]+$" },
              "lod": { "type": ["integer", "null"], "minimum": 0, "maximum": 7 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "plan": { "enum": ["replace", "keep", "rework", "drop"] },
    "prefix": { "type": "string", "pattern": "^[A-Z]+_$" },
    "count": { "type": "object", "additionalProperties": false, "required": ["files", "bytes"], "properties": { "files": { "type": "integer", "minimum": 0 }, "bytes": { "type": "integer", "minimum": 0 } } }
  }
}
