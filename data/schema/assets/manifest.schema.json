{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xaell.github.io/Tervain/data/schema/assets/manifest.schema.json",
  "title": "assets/manifest.json",
  "description": "Every model, texture, image and sound in the repository's asset folders, with what an Unreal Engine port does with it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "about",
    "generatedBy",
    "plans",
    "replaceBeforeShip",
    "unrealConventions",
    "totals",
    "fab",
    "groups",
    "assets"
  ],
  "properties": {
    "about": {
      "type": "string"
    },
    "generatedBy": {
      "type": "string"
    },
    "plans": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replace",
        "keep",
        "rework",
        "drop"
      ],
      "properties": {
        "replace": {
          "type": "string"
        },
        "keep": {
          "type": "string"
        },
        "rework": {
          "type": "string"
        },
        "drop": {
          "type": "string"
        }
      }
    },
    "replaceBeforeShip": {
      "description": "What happens to a file with an open question about its source or its licence terms, and who decided it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "decided",
        "by"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 40
        },
        "decided": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "by": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "unrealConventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "up",
        "handedness",
        "forward",
        "import",
        "contentRoot",
        "prefixes",
        "prefixSource",
        "textureSuffixes",
        "naming",
        "lod"
      ],
      "properties": {
        "units": {
          "const": "centimetres"
        },
        "up": {
          "const": "Z"
        },
        "handedness": {
          "const": "left-handed"
        },
        "forward": {
          "const": "+X"
        },
        "import": {
          "type": "string"
        },
        "contentRoot": {
          "type": "string",
          "pattern": "^/Game/"
        },
        "prefixes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/prefix"
          },
          "required": [
            "StaticMesh",
            "SkeletalMesh",
            "Texture",
            "Material",
            "MaterialInstance"
          ],
          "properties": {
            "StaticMesh": {
              "$ref": "#/$defs/prefix"
            },
            "SkeletalMesh": {
              "$ref": "#/$defs/prefix"
            },
            "Texture": {
              "$ref": "#/$defs/prefix"
            },
            "Material": {
              "$ref": "#/$defs/prefix"
            },
            "MaterialInstance": {
              "$ref": "#/$defs/prefix"
            }
          }
        },
        "prefixSource": {
          "type": "string"
        },
        "textureSuffixes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^_[A-Z]+$"
          }
        },
        "naming": {
          "type": "string"
        },
        "lod": {
          "type": "string"
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all",
        "shipped",
        "replaceBeforeShip",
        "byPlan"
      ],
      "properties": {
        "all": {
          "$ref": "#/$defs/count"
        },
        "shipped": {
          "$ref": "#/$defs/count"
        },
        "replaceBeforeShip": {
          "$ref": "#/$defs/count"
        },
        "byPlan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replace",
            "keep",
            "rework",
            "drop"
          ],
          "properties": {
            "replace": {
              "$ref": "#/$defs/count"
            },
            "keep": {
              "$ref": "#/$defs/count"
            },
            "rework": {
              "$ref": "#/$defs/count"
            },
            "drop": {
              "$ref": "#/$defs/count"
            }
          }
        }
      }
    },
    "fab": {
      "description": "What to look for on Fab for each replacement, keyed by the category a group names.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "brief",
          "constraints",
          "candidates"
        ],
        "properties": {
          "appliesTo": {
            "description": "For a category no group of files names: what in the port it answers for.",
            "type": "string"
          },
          "brief": {
            "type": "string"
          },
          "constraints": {
            "type": "string"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "publisher",
                "url",
                "engine",
                "price",
                "note",
                "verified",
                "checked"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "publisher": {
                  "type": "string",
                  "minLength": 2
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://www\\.fab\\.com/listings/[0-9a-f-]{36}$"
                },
                "engine": {
                  "description": "The Unreal Engine versions the listing gives, or null when it has no Unreal Engine format.",
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[45]\\.[0-9]+( to [45]\\.[0-9]+)?$"
                },
                "price": {
                  "description": "Prices of the Personal and Professional licences on the day the page was opened; 0 is free.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "personal",
                    "professional",
                    "currency"
                  ],
                  "properties": {
                    "personal": {
                      "type": "number",
                      "minimum": 0
                    },
                    "professional": {
                      "type": "number",
                      "minimum": 0
                    },
                    "currency": {
                      "const": "USD"
                    }
                  }
                },
                "verified": {
                  "description": "How the listing was confirmed to exist.",
                  "enum": [
                    "listing page",
                    "search result",
                    "not verified"
                  ]
                },
                "checked": {
                  "description": "The day the listing page was opened.",
                  "type": "string",
                  "pattern": "^2[0-9]{3}-[0-9]{2}-[0-9]{2}$"
                },
                "note": {
                  "description": "What the listing's page states, and what was only seen in search results.",
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "role",
          "plan",
          "why",
          "source",
          "fab",
          "replaceWith",
          "replaceBeforeShip",
          "files",
          "bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "role": {
            "enum": [
              "hero",
              "resident",
              "animation",
              "animal",
              "tree",
              "scenery",
              "furniture",
              "debug",
              "building-material",
              "foliage-texture",
              "interface-art",
              "identity",
              "music",
              "voice",
              "sound",
              "archive"
            ]
          },
          "plan": {
            "$ref": "#/$defs/plan"
          },
          "why": {
            "type": "string",
            "minLength": 20
          },
          "source": {
            "type": "string",
            "minLength": 10
          },
          "fab": {
            "type": [
              "string",
              "null"
            ]
          },
          "replaceWith": {
            "description": "For a group that is to be replaced: the first-choice pack and why, any companion packs it needs, and the pack to use instead on the web target, where Nanite is not available. Null for every other plan.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "publisher",
                  "url",
                  "engine",
                  "price",
                  "verified",
                  "checked",
                  "reason",
                  "with",
                  "webTarget"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 3
                  },
                  "publisher": {
                    "type": "string",
                    "minLength": 2
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://www\\.fab\\.com/listings/[0-9a-f-]{36}$"
                  },
                  "engine": {
                    "description": "The Unreal Engine versions the listing gives, or null when it has no Unreal Engine format.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[45]\\.[0-9]+( to [45]\\.[0-9]+)?$"
                  },
                  "price": {
                    "description": "Prices of the Personal and Professional licences on the day the page was opened; 0 is free.",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "personal",
                      "professional",
                      "currency"
                    ],
                    "properties": {
                      "personal": {
                        "type": "number",
                        "minimum": 0
                      },
                      "professional": {
                        "type": "number",
                        "minimum": 0
                      },
                      "currency": {
                        "const": "USD"
                      }
                    }
                  },
                  "verified": {
                    "description": "How the listing was confirmed to exist.",
                    "enum": [
                      "listing page",
                      "search result",
                      "not verified"
                    ]
                  },
                  "checked": {
                    "description": "The day the listing page was opened.",
                    "type": "string",
                    "pattern": "^2[0-9]{3}-[0-9]{2}-[0-9]{2}$"
                  },
                  "reason": {
                    "description": "Why this pack is the first choice, from what its page says.",
                    "type": "string",
                    "minLength": 40
                  },
                  "with": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/pack"
                    }
                  },
                  "webTarget": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/pack"
                      }
                    ]
                  }
                }
              }
            ]
          },
          "replaceBeforeShip": {
            "description": "For a group that holds files with an open question about their source or licence terms: the question, and how many files and bytes it concerns. Such a group is always one that is replaced. Null for every other group.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question",
                  "files",
                  "bytes"
                ],
                "properties": {
                  "question": {
                    "type": "string",
                    "minLength": 40
                  },
                  "files": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          },
          "files": {
            "type": "integer",
            "minimum": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "group",
          "kind",
          "bytes",
          "sha256",
          "shipped",
          "licence",
          "plan",
          "unreal"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(public|assets)/"
          },
          "group": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "model",
              "texture",
              "image",
              "font",
              "audio",
              "data"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "shipped": {
            "description": "Whether the web build serves the file (it is under public/).",
            "type": "boolean"
          },
          "sourceId": {
            "description": "The source record in the model ledger (public/model-licenses.json).",
            "type": "string"
          },
          "licence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "description": "An SPDX identifier, or a LicenseRef- name for terms that have none.",
                "type": "string",
                "pattern": "^(CC0-1\\.0|LicenseRef-[A-Za-z0-9.-]+)$"
              },
              "status": {
                "description": "How well the licence is established, in the words of its record.",
                "type": "string",
                "minLength": 3
              }
            }
          },
          "plan": {
            "$ref": "#/$defs/plan"
          },
          "replaceWith": {
            "description": "For a file that is to be replaced: the title of its group's first-choice pack.",
            "type": "string",
            "minLength": 3
          },
          "replaceBeforeShip": {
            "description": "Present and true on a file with an open question about its source or its licence terms: it is replaced before anything is released.",
            "const": true
          },
          "unreal": {
            "description": "The Unreal asset an import of this file produces; null when nothing is imported from it.",
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "type",
              "folder",
              "name",
              "lod"
            ],
            "properties": {
              "type": {
                "enum": [
                  "StaticMesh",
                  "SkeletalMesh",
                  "Texture",
                  "AnimationSequence",
                  "SoundWave"
                ]
              },
              "folder": {
                "type": "string",
                "pattern": "^/Game/Tervain/"
              },
              "name": {
                "type": "string",
                "pattern": "^(SM|SK|T|AS|SW)_[A-Za-z0-9_]+$"
              },
              "lod": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 7
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "replaceBeforeShip": {
                  "const": true
                }
              },
              "required": [
                "replaceBeforeShip"
              ]
            },
            "then": {
              "properties": {
                "plan": {
                  "const": "replace"
                },
                "replaceWith": {
                  "type": "string"
                }
              },
              "required": [
                "replaceWith"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "plan": {
      "enum": [
        "replace",
        "keep",
        "rework",
        "drop"
      ]
    },
    "prefix": {
      "type": "string",
      "pattern": "^[A-Z]+_$"
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "bytes"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pack": {
      "description": "A Fab listing named as a replacement: one of the candidates of the group's Fab category.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url",
        "engine",
        "price",
        "verified",
        "checked"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "pattern": "^https://www\\.fab\\.com/listings/[0-9a-f-]{36}$"
        },
        "engine": {
          "description": "The Unreal Engine versions the listing gives, or null when it has no Unreal Engine format.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[45]\\.[0-9]+( to [45]\\.[0-9]+)?$"
        },
        "price": {
          "description": "Prices of the Personal and Professional licences on the day the page was opened; 0 is free.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "personal",
            "professional",
            "currency"
          ],
          "properties": {
            "personal": {
              "type": "number",
              "minimum": 0
            },
            "professional": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "const": "USD"
            }
          }
        },
        "verified": {
          "description": "How the listing was confirmed to exist.",
          "enum": [
            "listing page",
            "search result",
            "not verified"
          ]
        },
        "checked": {
          "description": "The day the listing page was opened.",
          "type": "string",
          "pattern": "^2[0-9]{3}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
