{
  "name": "tervain",
  "version": "0.1.17",
  "private": true,
  "type": "module",
  "description": "Tervain exploration prototype: silent Grey Strand arrival / Templar deepwood",
  "scripts": {
    "play-gate": "node tools/play-gate.mjs",
    "perf:load": "node tools/load-stages.mjs",
    "perf:frame": "node tools/frame-passes.mjs",
    "perf:programs": "node tools/shader-programs.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "npm run typecheck:game && npm run typecheck:gothic3",
    "typecheck:game": "tsc --noEmit -p tsconfig.game.json && tsc --noEmit -p tsconfig.core.json",
    "typecheck:gothic3": "tsc --noEmit -p tsconfig.gothic3.json",
    "test": "vitest run",
    "test:game": "vitest run --project game",
    "test:gothic3": "vitest run --project gothic3",
    "check": "npm run typecheck:game && npm run data:check && npm run test:game && npm run hygiene:check -- --base origin/main",
    "preview": "vite preview --host 127.0.0.1",
    "people:sheets": "node tools/export-people-sheets.mjs",
    "people:check": "node tools/export-people-sheets.mjs --check",
    "data:export": "node tools/export-data.mjs",
    "data:check": "node tools/export-data.mjs --check",
    "assets:manifest": "node tools/asset-manifest.mjs",
    "assets:check": "node tools/asset-manifest.mjs --check",
    "docs:sources": "node tools/check-doc-sources.mjs",
    "hygiene:check": "node tools/commit-hygiene.mjs",
    "smoke:live": "node tools/live-smoke.mjs",
    "unreal:check": "node tools/export-data.mjs --check && node tools/engine-symbols.mjs && vitest run tests/tools/unrealDrift.test.ts tests/tools/unrealSkeleton.test.ts tests/tools/unrealRulesParity.test.ts tests/tools/unrealSeedBuild.test.ts tests/tools/engineSymbols.test.ts",
    "unreal:symbols": "node tools/engine-symbols.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "es-module-lexer": "^2.3.2",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "^0.186.1"
  }
}
