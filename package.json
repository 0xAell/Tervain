{
  "name": "tervain",
  "version": "0.0.48",
  "private": true,
  "type": "module",
  "description": "Tervain exploration prototype: silent Grey Strand arrival / Templar deepwood",
  "scripts": {
    "play-gate": "node tools/play-gate.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "test": "vitest run",
    "preview": "vite preview",
    "people:sheets": "node tools/export-people-sheets.mjs",
    "people:check": "node tools/export-people-sheets.mjs --check",
    "data:export": "node tools/export-data.mjs",
    "data:check": "node tools/export-data.mjs --check",
    "assets:manifest": "node tools/asset-manifest.mjs",
    "assets:check": "node tools/asset-manifest.mjs --check",
    "docs:sources": "node tools/check-doc-sources.mjs",
    "hygiene:check": "node tools/commit-hygiene.mjs",
    "unreal:check": "node tools/export-data.mjs --check && vitest run tests/tools/unrealDrift.test.ts tests/tools/unrealSkeleton.test.ts tests/tools/unrealRulesParity.test.ts tests/tools/unrealSeedBuild.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "^0.186.1"
  }
}
